<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>

    <!--
      产品信息。原先完全没有版本号，「设置 → 关于」无处显示，
      出问题时也无法确认用户跑的是哪一版。
    -->
    <Version>1.1.0</Version>
    <Product>XAssistant</Product>
    <Company>YYiChen</Company>
    <Description>本机输入与使用情况记录工具（个人自用）</Description>

    <!--
      DPI 感知与应用清单（计划 A7）。
      PerMonitorV2（多显示器不同缩放比例下文字不模糊）与 asInvoker
      （明确以普通用户权限运行）都在 app.manifest 里声明 ——
      WPF 的 DPI 感知由清单控制，不是通过 MSBuild 属性。
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      抑制 WFO0003。该警告建议把高 DPI 设置从 manifest 移到
      ApplicationHighDpiMode 属性 —— 但那是 WinForms 的做法，只对
      System.Windows.Forms.Application 生效。本项目主要用 WPF
      （启用 UseWindowsForms 仅为了托盘 NotifyIcon），
      WPF 的 DPI 感知必须由 manifest 的 dpiAwareness 声明，
      按该建议改反而会丢失 PerMonitorV2。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="XAssistant.Service\**" />
    <EmbeddedResource Remove="XAssistant.Service\**" />
    <None Remove="XAssistant.Service\**" />
    <Page Remove="XAssistant.Service\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>
</Project>
