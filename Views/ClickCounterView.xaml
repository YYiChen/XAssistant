<UserControl
  x:Class="XAssistant.Views.ClickCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:XAssistant.Converters"
  xmlns:vm="clr-namespace:XAssistant.ViewModels">
  <UserControl.Resources>
    <converters:InverseBoolConverter x:Key="InverseBool" />

    <!--  小卡片样式（总计/历史）  -->
    <Style x:Key="SmallCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="80" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect
            BlurRadius="6"
            Opacity="0.15"
            ShadowDepth="2"
            Color="Gray" />
        </Setter.Value>
      </Setter>
    </Style>

    <!--  今日卡片样式（高亮）  -->
    <Style x:Key="TodayCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#0078D4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="130" />
      <Setter Property="Height" Value="100" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect
            BlurRadius="8"
            Opacity="0.25"
            ShadowDepth="3"
            Color="Black" />
        </Setter.Value>
      </Setter>
    </Style>

    <!--  历史日期卡片样式  -->
    <Style x:Key="HistoryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="80" />
      <Setter Property="BorderBrush" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  卡片内数字样式  -->
    <Style x:Key="CardBigNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--  卡片内标题样式  -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#666666" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" VerticalAlignment="Top">

      <!--  ========== 总计区域 ==========  -->
      <!--
        标题后补上合计数：原先只有「总左键 / 总中键 / 总右键」三个分类数字，
        没有「一共点了多少下」这个最常用的量。键盘页同样的问题已一并修复，
        两页现在保持一致的「分类 + 合计」信息层级。
      -->
      <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
        <TextBlock
          FontSize="16"
          FontWeight="SemiBold"
          Text="总计" />
        <TextBlock
          Margin="10,0,0,0"
          VerticalAlignment="Bottom"
          Style="{StaticResource Text.Secondary}"
          Text="{Binding MouseTotalClicks, StringFormat='{}{0:N0} 次'}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding LeftClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding MiddleClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding RightClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总右键" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!--  ========== 今天（突出显示） ==========  -->
      <StackPanel Margin="0,25,0,10" Orientation="Horizontal">
        <TextBlock
          FontSize="20"
          FontWeight="Bold"
          Text="今天" />
        <TextBlock
          Margin="10,0,0,0"
          VerticalAlignment="Bottom"
          Style="{StaticResource Text.Secondary}"
          Text="{Binding MouseTodayClicks, StringFormat='{}{0:N0} 次'}" />
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding LeftClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding MiddleClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding RightClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="右键" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!--  ========== 日历与历史查看 ==========  -->
      <GroupBox
        Margin="0,25,0,0"
        Padding="10"
        Header="查看历史">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <!--  日历控件  -->
          <Calendar
            Grid.Column="0"
            DisplayMode="Month"
            IsTodayHighlighted="True"
            SelectedDate="{Binding SelectedDate}" />

          <!--  选中日期的统计卡片  -->
          <StackPanel
            Grid.Column="1"
            Margin="15,0,0,0"
            VerticalAlignment="Top">
            <TextBlock
              Margin="0,0,0,12"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding SelectedDate, StringFormat='📅 {0:yyyy/MM/dd}'}" />
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateLeftCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="左键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateMiddleCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="中键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateRightCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="右键" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!--
        ========== 记录状态 ==========
        原先这里是一对「开始记录 / 停止记录」按钮。按 2026-10-07 的决策，
        记录开关已统一移到「设置」页 —— 本页现在只显示状态。
        （此前键盘页用 Visibility 切换、本页用 IsEnabled，两处行为并不一致。）
      -->
      <StackPanel
        Margin="0,20,0,10"
        HorizontalAlignment="Center"
        Orientation="Horizontal">
        <Ellipse
          Style="{StaticResource Status.Dot}"
          Fill="{Binding MouseRecordingColor}"
          VerticalAlignment="Center" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{StaticResource Text.Body}"
          Text="{Binding MouseRecordingStatus}" />
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource Text.Caption}"
          Text="记录开关已移至「设置」页" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
