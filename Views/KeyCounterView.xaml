<UserControl
  x:Class="XAssistant.Views.KeyCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  xmlns:vm="clr-namespace:XAssistant.ViewModels">
  <UserControl.Resources>
    <!--  四个排序视图  -->
    <CollectionViewSource x:Key="SortedTotal" Source="{Binding KeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedToday" Source="{Binding TodayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedYesterday" Source="{Binding YesterdayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedDayBefore" Source="{Binding DayBeforeYesterdayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <DockPanel>
    <!--
      顶部状态区。

      原先这里是一对「开始录制 / 停止录制」按钮。按 2026-10-07 的决策，
      记录开关已统一移到「设置」页 —— 原因是键盘页用 Visibility 切换按钮、
      鼠标页却用 IsEnabled，两处行为并不一致，且同一个概念在两个页面各放一套。
      本页现在只显示状态，不再提供开关。
    -->
    <StackPanel
      Margin="20,16,20,12"
      DockPanel.Dock="Top"
      Orientation="Horizontal">
      <Ellipse
        Style="{StaticResource Status.Dot}"
        Fill="{Binding KeyRecordingColor}"
        VerticalAlignment="Center" />
      <TextBlock
        VerticalAlignment="Center"
        Style="{StaticResource Text.Body}"
        Text="{Binding KeyRecordingStatus}" />
      <TextBlock
        Margin="12,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource Text.Caption}"
        Text="记录开关已移至「设置」页" />

      <Button
        Margin="16,0,0,0"
        VerticalAlignment="Center"
        Command="{Binding RefreshDataCommand}"
        Content="刷新数据"
        Style="{StaticResource Button.Secondary}" />
    </StackPanel>

    <!--
      汇总区。

      此前本页只有下方那张「按键 → 次数」明细表，没有「今天一共按了多少次」
      这样的一眼可见数字 —— 而鼠标页是有「总计 / 今天」分区的，两页信息层级不一致。
      ViewModel 里的 KeyTodayPresses / KeyTotalPresses 一直存在却从未被绑定，
      这里把它们用上。
    -->
    <Border
      DockPanel.Dock="Top"
      Margin="20,0,20,12"
      Style="{StaticResource Card}">
      <StackPanel Orientation="Horizontal">
        <StackPanel>
          <TextBlock
            Style="{StaticResource Text.MetricLarge}"
            Text="{Binding KeyTodayPresses, StringFormat=N0}" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="今日按键" />
        </StackPanel>
        <StackPanel Margin="56,0,0,0">
          <TextBlock
            Style="{StaticResource Text.MetricLarge}"
            Text="{Binding KeyTotalPresses, StringFormat=N0}" />
          <TextBlock
            Margin="0,2,0,0"
            Style="{StaticResource Text.Caption}"
            Text="历史总计" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!--  Tab 切换区  -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="总计">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedTotal}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="今天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedToday}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="昨天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedYesterday}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="前天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedDayBefore}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
