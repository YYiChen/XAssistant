<!--
    调色板 · 克制的原生风

    设计约束（2026-10-07 确认）：
      · 中性灰阶为主 + 单一主色，不做渐变、不做重投影
      · 圆角克制（2–6px），边框 1px 且浅
      · 长时间盯屏的工具类软件，克制比抢眼更耐看

    用法约定：界面中【禁止】再写颜色字面量（如 #666666），一律引用这里的
    语义化画刷。这样后续要支持深色模式时，只需替换本文件的取值。
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  ==================== 原始色值 ====================  -->
  <!--  仅在本文件内使用；界面应引用下方的语义画刷  -->

  <!--  中性灰阶  -->
  <Color x:Key="Color.Neutral.0">#FFFFFFFF</Color>
  <Color x:Key="Color.Neutral.5">#FFF7F8FA</Color>
  <Color x:Key="Color.Neutral.10">#FFEFF1F3</Color>
  <Color x:Key="Color.Neutral.20">#FFE1E4E8</Color>
  <Color x:Key="Color.Neutral.40">#FFC4C9D0</Color>
  <Color x:Key="Color.Neutral.60">#FF9AA1AB</Color>
  <Color x:Key="Color.Neutral.70">#FF6E7681</Color>
  <Color x:Key="Color.Neutral.80">#FF49515B</Color>
  <Color x:Key="Color.Neutral.90">#FF2B3138</Color>
  <Color x:Key="Color.Neutral.95">#FF1B1F24</Color>

  <!--  主色（沿用原实现的主蓝，收敛为单一强调色）  -->
  <Color x:Key="Color.Accent">#FF0F6CBD</Color>
  <Color x:Key="Color.Accent.Hover">#FF1A7DD3</Color>
  <Color x:Key="Color.Accent.Pressed">#FF0C5A9B</Color>
  <Color x:Key="Color.Accent.Subtle">#FFEAF3FC</Color>

  <!--  状态色  -->
  <Color x:Key="Color.Success">#FF107C10</Color>
  <Color x:Key="Color.Warning">#FF9D5D00</Color>
  <Color x:Key="Color.Error">#FFC42B1C</Color>

  <!--  ==================== 背景与表面 ====================  -->

  <!--  窗口主背景  -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Neutral.0}" />

  <!--  侧边栏背景（略深于主背景，形成分区）  -->
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Neutral.5}" />

  <!--  卡片 / 面板背景  -->
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral.0}" />
  <SolidColorBrush x:Key="Brush.Surface.Alt" Color="{StaticResource Color.Neutral.5}" />

  <!--  交互态背景  -->
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Neutral.10}" />
  <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Neutral.20}" />
  <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Accent.Subtle}" />

  <!--  ==================== 边框与分隔 ====================  -->
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Neutral.20}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Neutral.40}" />
  <SolidColorBrush x:Key="Brush.Separator" Color="{StaticResource Color.Neutral.10}" />

  <!--  ==================== 文字 ====================  -->
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Neutral.95}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Neutral.70}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Neutral.60}" />
  <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Neutral.0}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Neutral.40}" />

  <!--  ==================== 强调与状态 ====================  -->
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />

  <!--  ==================== 形状与间距 ====================  -->

  <!--  圆角：克制取值，仅用于按钮与卡片  -->
  <CornerRadius x:Key="Radius.Small">2</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
  <CornerRadius x:Key="Radius.Large">6</CornerRadius>

  <!--  间距阶梯（8 的倍数为主，便于对齐）  -->
  <Thickness x:Key="Space.XXS">4</Thickness>
  <Thickness x:Key="Space.XS">8</Thickness>
  <Thickness x:Key="Space.S">12</Thickness>
  <Thickness x:Key="Space.M">16</Thickness>
  <Thickness x:Key="Space.L">24</Thickness>
  <Thickness x:Key="Space.XL">32</Thickness>

  <!--  常用复合内边距  -->
  <Thickness x:Key="Padding.Card">16</Thickness>
  <Thickness x:Key="Padding.Control">10,6</Thickness>
  <Thickness x:Key="Padding.Page">24</Thickness>
</ResourceDictionary>
