<!--
    控件样式

    刻意【只提供键控样式】（带 x:Key），不定义隐式样式（无 x:Key 的那种）。
    原因：隐式样式会立即改变所有同类控件的外观，而未迁移的统计页
    （KeyCounter / ClickCounter / Usage / AppUsage / Home）仍依赖 WPF 默认外观。
    统一改为「逐页显式引用」，迁移到哪页、哪页才换装，避免一次性布局回归。

    依赖：需在 App.xaml 中于 Palette.xaml、Typography.xaml 之后合并。
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  ══════════════ 侧边栏导航项 ══════════════  -->

  <!--
      用于 ListBox 的 ItemContainerStyle。

      选 ListBox 而不是一排 ToggleButton：ListBox 天然提供「单选互斥」
      与 SelectedItem 双向绑定，不必自己维护一组互斥的布尔属性。
      这里通过重写模板去掉默认的选中高亮（那套蓝色方块与整体风格不符），
      换成克制的浅色底 + 文字转主色。
  -->
  <Style x:Key="Nav.Item" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border
            x:Name="Root"
            Margin="8,1"
            Padding="12,9"
            Background="Transparent"
            CornerRadius="{StaticResource Radius.Medium}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selected}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  导航列表容器：去掉 ListBox 默认的白底与边框  -->
  <Style x:Key="Nav.ListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Nav.Item}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--  导航项内的图标（Segoe Fluent Icons 字形）  -->
  <Style x:Key="Nav.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <!--  不设 Foreground：继承导航项的着色，选中时随之变主色  -->
  </Style>

  <!--  ══════════════ 按钮 ══════════════  -->

  <Style x:Key="Button.Primary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAccent}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Root"
            Background="{StaticResource Brush.Accent}"
            CornerRadius="{StaticResource Radius.Medium}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Border}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Secondary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
    <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Root"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Medium}"
            Padding="{TemplateBinding Padding}">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface.Alt}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  ══════════════ 容器 ══════════════  -->

  <!--  卡片：用于把相关设置/指标归为一组  -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Large}" />
    <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
  </Style>

  <!--  1px 分隔线  -->
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Brush.Separator}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--  ══════════════ 状态指示 ══════════════  -->

  <!--
      记录状态圆点。用 Ellipse + 绑定颜色，
      避免各页再各自拼一套颜色与文案（原先键盘页/鼠标页的实现并不一致）。
  -->
  <Style x:Key="Status.Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>
</ResourceDictionary>
